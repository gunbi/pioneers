{
  "type": "object",
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 48},
    "goal": {"type": "string"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "role": {"enum": ["ld", "pm", "engineer", "qa"]},
          "prompt": {"type": "string"},
          "deliverable_type": {"enum": ["image", "video", null], "description": "Final generated poster/image or video. Use media.type=image plus media.prompt, or video_prompt, respectively."},
          "video_prompt": {"type": ["string", "null"], "minLength": 1, "maxLength": 10000},
          "video_settings": {
            "type": "object",
            "description": "Video request overrides. Register each promised final duration (seconds), aspect ratio, or resolution.",
            "properties": {
              "duration": {"type": "integer", "minimum": 1},
              "ratio": {"type": "string", "pattern": "^[1-9][0-9]?:[1-9][0-9]?$"},
              "resolution": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,24}$"}
            },
            "minProperties": 1,
            "additionalProperties": false
          },
          "media_copy_from": {"type": "string", "description": "Direct dependency whose accepted deliverable contains one fenced media-copy block of approved public poster text."},
          "media": {
            "type": ["object", "null"],
            "properties": {
              "type": {"enum": ["image", "speech", "music", "sound_effect"]},
              "aspect_ratio": {"type": "string", "pattern": "^[1-9][0-9]?:[1-9][0-9]?$", "description": "Image canvas width:height; SiliconFlow dispatch resolves it to a model-specific image_size."},
              "prompt": {"type": "string", "minLength": 1, "maxLength": 10000},
              "voice": {"type": "string", "minLength": 1, "maxLength": 256}
            },
            "required": ["type", "prompt"],
            "additionalProperties": false
          },
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "ui_design": {"type": ["array", "null"], "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "write_paths": {"type": "array", "items": {"type": "string"}},
          "skills": {"type": "array", "items": {"type": "string"}},
          "tools": {"type": "array", "items": {"type": "string"}},
          "review": {"type": "boolean"},
          "effect": {"enum": [null, "send", "publish", "payment", "permissions", "delete", "irreversible"]},
          "impact": {"enum": [null, "architecture", "feature_design", "costly_change"]},
          "complexity": {
            "type": "object",
            "properties": {
              "level": {"enum": ["low", "medium", "high"]},
              "reason": {"type": "string"}
            },
            "required": ["level", "reason"],
            "additionalProperties": false
          },
          "acceptance": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["id", "role", "prompt", "depends_on", "write_paths", "skills", "tools", "review", "effect", "impact", "complexity", "acceptance"],
        "additionalProperties": false
      }
    }
  },
  "required": ["goal", "tasks"],
  "additionalProperties": false
}
