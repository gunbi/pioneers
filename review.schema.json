{
  "type": "object",
  "properties": {
    "outcome": {"enum": ["accepted", "changes_requested", "needs_clarification", "blocked"]},
    "summary": {"type": "string"},
    "repair_task": {"type": ["string", "null"]},
    "visual_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "design": {"type": "string"},
          "screenshot": {"type": "string"},
          "viewport": {"type": "string", "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"},
          "scenario": {"type": "string"}
        },
        "required": ["design", "screenshot", "viewport", "scenario"],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {"type": "string"},
          "status": {"enum": ["pass", "fail", "unverified"]},
          "evidence": {"type": "string"}
        },
        "required": ["criterion", "status", "evidence"],
        "additionalProperties": false
      }
    }
  },
  "required": ["outcome", "summary", "repair_task", "checks"],
  "additionalProperties": false
}
