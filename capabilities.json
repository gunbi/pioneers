  "mcp_servers": {
    "pioneers_git": {
      "source": "https://github.com/modelcontextprotocol/servers/tree/main/src/git",
      "description": "查看目标 Git 仓库，或按角色权限暂存、提交与创建分支。",
      "settings": {
        "command": "uvx",
        "args": ["mcp-server-git==2026.11.11", "--repository", "{workspace}"],
        "startup_timeout_sec": 60
      },
      "profiles": {
        "read": ["git_status", "git_diff_unstaged", "git_diff_staged", "git_diff", "git_log", "git_show"],
        "write": ["git_add", "git_commit", "git_create_branch"]
      }
    },
    "pioneers_github": {
      "source": "https://github.com/github/github-mcp-server",
      "description": "只读查看有权限的 GitHub 仓库、Issue 和 PR。",
      "settings": {
        "url": "https://api.githubcopilot.com/mcp/x/all/readonly",
        "bearer_token_env_var": "GITHUB_PERSONAL_ACCESS_TOKEN"
      },
      "profiles": {
        "read": ["get_file_contents", "list_issues", "issue_read", "list_pull_requests", "pull_request_read"]
      }
    },
    "pioneers_playwright": {
      "source": "https://github.com/microsoft/playwright-mcp",
      "description": "打开 Web 页面、模拟用户操作，采集页面状态和验证证据。",
      "settings": {
        "command": "npx",
        "args": ["--yes", "@playwright/mcp@0.0.85", "--isolated", "--headless"],
        "startup_timeout_sec": 60
      },
      "profiles": {
        "test": [
          "browser_navigate", "browser_snapshot", "browser_click", "browser_type",
          "browser_fill_form", "browser_press_key", "browser_resize",
          "browser_take_screenshot", "browser_console_messages", "browser_close"
        ]
      }
    }
  },
